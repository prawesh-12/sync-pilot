# Must match SYNC_SECRET in the web app.
SYNC_SECRET=

# Use "redis" in Docker Compose, "localhost" when running directly.
REDIS_HOST=redis
REDIS_PORT=6379

PORT=3001

# Base URL the worker calls to run the agent.
WEB_APP_URL=

# /admin/queues is only mounted when both are set.
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=

# debug | info (default) | warn | error | silent
LOG_LEVEL=

# Telemetry stays off unless this endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
# Copy the whole generated line from the Grafana OpenTelemetry tile.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-instance-id-and-token>
# http/protobuf (default) or http/json. gRPC is not supported.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Becomes service.name in Grafana. Use a different value for the worker.
OTEL_SERVICE_NAME=syncpilot-server
