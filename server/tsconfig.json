{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["**/*.ts", "../tests/server_test/**/*.ts"],
  "exclude": ["node_modules"]
}
