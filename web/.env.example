# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

DATABASE_URL=

COMPOSIO_API_KEY=
# Gmail toolkit Auth Config ID from the Composio dashboard.
COMPOSIO_GMAIL_AUTH_CONFIG_ID=

# 64 character hex.
ENCRYPTION_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

SIGNAL_CLI_REST_URL=http://localhost:8080
# Leave empty locally. In production the reverse proxy checks this header.
SIGNAL_AUTH_TOKEN=

CRON_SECRET=

# Must match SYNC_SECRET in the server.
SYNC_SECRET=
# When blank, the cron runs each account inline instead of queueing.
INTAKE_SERVER_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
# Billing counts as unconfigured unless all four are set.
RAZORPAY_WEBHOOK_SECRET=

# debug | info (default) | warn | error | silent
LOG_LEVEL=

# Telemetry stays off unless this endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
# Copy the whole generated line from the Grafana OpenTelemetry tile.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-instance-id-and-token>
# http/protobuf (default) or http/json. gRPC is not supported.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Becomes service.name in Grafana.
OTEL_SERVICE_NAME=syncpilot-web
